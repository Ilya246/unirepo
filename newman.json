      "name": "POST /users - Create admin user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userType\":\"Admin\",\"username\":\"admin\",\"password\":\"admin123\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        }
      }
    },
    {
      "name": "Authentication Tests",
      "item": [
        {
          "name": "Get Admin Auth Header",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const credentials = pm.variables.get('adminUsername') + ':' + pm.variables.get('adminPassword');",
                  "const base64Credentials = btoa(credentials);",
                  "pm.variables.set('authToken', 'Basic ' + base64Credentials);",
                  "pm.test(\"Auth token generated\", function() {",
                  "    pm.expect(pm.variables.get('authToken')).to.include('Basic ');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"]
            }
          }
        }
      ]
    },
